# Copy to .env. Everything here is read by app/core/config.py.
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=transcripts

# LLM: LiteLLM provider prefix + per-role model names. Pick models from your dashboard
# and compare with `make eval`. Nothing is hardcoded in code.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_BASE=
LLM_API_VERSION=
MODEL_EXTRACT=
MODEL_FILTER=
MODEL_REPAIR=
MODEL_EDIT=

# Azure OpenAI example (config only, no code change):
# LLM_PROVIDER=azure
# LLM_API_BASE=https://<resource>.openai.azure.com
# LLM_API_VERSION=<api-version>
# MODEL_EXTRACT=<deployment-name>   (same for FILTER / REPAIR / EDIT)

# Audio transcription (fallback when no platform transcript export exists).
# Diarization is used when the model supports it (name contains "diarize", e.g. the OpenAI
# diarize model); otherwise speakers come back as "Unknown speaker".
TRANSCRIBE_PROVIDER=openai
TRANSCRIBE_MODEL=
TRANSCRIBE_API_KEY=          # optional; falls back to LLM_API_KEY
TRANSCRIBE_API_BASE=
TRANSCRIBE_CHUNK_SECONDS=600

# Tracing is a no-op unless both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
