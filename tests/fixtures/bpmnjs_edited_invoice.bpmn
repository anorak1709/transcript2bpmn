<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="transcript2bpmn" exporterVersion="0.1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Supplier invoice approval" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Supplier invoice approval" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_lane_ap" name="Accounts Payable">
        <bpmn:flowNodeRef>Node_t_enter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_t_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_g_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_t_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_end_returned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_g_amount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_t_ap_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0gufld4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_lane_fin" name="Finance">
        <bpmn:flowNodeRef>Node_t_fin_approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_g_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_t_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_end_paid</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="Node_t_enter" name="Enter invoice into ERP">
      <bpmn:incoming>Flow_f1</bpmn:incoming>
      <bpmn:outgoing>Flow_0jt0e2g</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_t_match" name="Match invoice to purchase order">
      <bpmn:incoming>Flow_0hc6jvc</bpmn:incoming>
      <bpmn:outgoing>Flow_f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Node_g_match" name="Invoice matches PO?">
      <bpmn:incoming>Flow_f3</bpmn:incoming>
      <bpmn:outgoing>Flow_f4</bpmn:outgoing>
      <bpmn:outgoing>Flow_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Node_t_return" name="Return invoice to supplier">
      <bpmn:incoming>Flow_f4</bpmn:incoming>
      <bpmn:outgoing>Flow_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Node_end_returned" name="Invoice returned">
      <bpmn:incoming>Flow_f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Node_g_amount" name="Amount over $5,000?">
      <bpmn:incoming>Flow_f6</bpmn:incoming>
      <bpmn:outgoing>Flow_f7</bpmn:outgoing>
      <bpmn:outgoing>Flow_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Node_t_fin_approve" name="Approve invoice (finance)">
      <bpmn:incoming>Flow_f7</bpmn:incoming>
      <bpmn:outgoing>Flow_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Node_t_ap_approve" name="Approve invoice (AP)">
      <bpmn:incoming>Flow_f8</bpmn:incoming>
      <bpmn:outgoing>Flow_f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Node_g_join" name="">
      <bpmn:incoming>Flow_f9</bpmn:incoming>
      <bpmn:incoming>Flow_f10</bpmn:incoming>
      <bpmn:outgoing>Flow_f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Node_t_pay" name="Release payment">
      <bpmn:incoming>Flow_f11</bpmn:incoming>
      <bpmn:outgoing>Flow_f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Node_end_paid" name="Invoice paid">
      <bpmn:incoming>Flow_f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_f1" sourceRef="Node_start" targetRef="Node_t_enter" />
    <bpmn:sequenceFlow id="Flow_f3" sourceRef="Node_t_match" targetRef="Node_g_match" />
    <bpmn:sequenceFlow id="Flow_f4" name="No match" sourceRef="Node_g_match" targetRef="Node_t_return">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No match</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_f5" sourceRef="Node_t_return" targetRef="Node_end_returned" />
    <bpmn:sequenceFlow id="Flow_f6" name="Matches" sourceRef="Node_g_match" targetRef="Node_g_amount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Matches</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_f7" name="Over $5,000" sourceRef="Node_g_amount" targetRef="Node_t_fin_approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Over $5,000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_f8" name="Up to $5,000" sourceRef="Node_g_amount" targetRef="Node_t_ap_approve" />
    <bpmn:sequenceFlow id="Flow_f9" sourceRef="Node_t_fin_approve" targetRef="Node_g_join" />
    <bpmn:sequenceFlow id="Flow_f10" sourceRef="Node_t_ap_approve" targetRef="Node_g_join" />
    <bpmn:sequenceFlow id="Flow_f11" sourceRef="Node_g_join" targetRef="Node_t_pay" />
    <bpmn:sequenceFlow id="Flow_f12" sourceRef="Node_t_pay" targetRef="Node_end_paid" />
    <bpmn:task id="Activity_0gufld4" name="Scan invoice">
      <bpmn:incoming>Flow_0jt0e2g</bpmn:incoming>
      <bpmn:outgoing>Flow_0hc6jvc</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_0jt0e2g" sourceRef="Node_t_enter" targetRef="Activity_0gufld4" />
    <bpmn:sequenceFlow id="Flow_0hc6jvc" sourceRef="Activity_0gufld4" targetRef="Node_t_match" />
    <bpmn:startEvent id="Node_start" name="Invoice received">
      <bpmn:outgoing>Flow_f1</bpmn:outgoing>
    </bpmn:startEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
